% academic-cv.sty
% LaTeX style for an academic job-market CV, designed to be populated by the
% Django backend (see academic/cv_builder.py).
%
% Black on white throughout. Sections are unnumbered headings over a thin rule,
% subsections are bold run-of-text headings, and entries come in three kinds:
%
%     \cventry{G2}{<heading>}{<date>}{<details>}   a dated entry; the tag may
%                                                  be empty for an unnumbered one
%     \cvcite{J3}{<citation>}                      a numbered citation
%     \cvplain{<text>}                             an unnumbered list item
%
% A tag prints in brackets in a hanging column, and \label/\ref resolve to the
% same bracketed tag ("[J3]"), which is how the CV cross-references itself.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academic-cv}[2026/10/04 Academic CV Style]

% --- PACKAGES ----------------------------------------------------------------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{mathptmx}          % Times
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage{hyperref}

\geometry{
    letterpaper,
    left=1in,
    right=1in,
    top=1in,
    bottom=1in,
    headheight=0pt,
    headsep=0pt,
    footskip=0.45in
}

\hypersetup{
    hidelinks,
    pdftitle={Curriculum Vitae},
}

\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{2em}  % absorb long URLs in citations
\widowpenalty=10000
\clubpenalty=10000
\setlength{\parskip}{0pt}
\setcounter{secnumdepth}{-2}
\setcounter{tocdepth}{-2}

% --- FOOTER ------------------------------------------------------------------
\newcommand{\@cvfootername}{}
\newcommand{\cvfootername}[1]{\renewcommand{\@cvfootername}{#1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\small\@cvfootername}
\fancyfoot[R]{\small\thepage}

% --- HEADER BLOCK ------------------------------------------------------------
\newenvironment{cvheader}{\begin{center}}{\end{center}\vspace{1mm}}
\newcommand{\cvname}[1]{{\LARGE\bfseries #1}\par\vspace{0.6ex}}
\newcommand{\cvheaderline}[1]{#1\par}
\newcommand{\cvcontact}[1]{\vspace{0.4ex}#1\par}
\newcommand{\cvsep}{\enspace\textbullet\enspace}

% --- HEADINGS ----------------------------------------------------------------
% A page break can never fall between a heading and what follows it: every
% heading ends in \nobreak, and the entries below open with glue only.
\newcommand{\cvsection}[1]{%
    \par\addvspace{1.4\baselineskip}%
    {\large\bfseries\scshape #1}\par\nobreak
    \vspace{1.5pt}\hrule height 0.4pt\nobreak
    \vspace{0.35\baselineskip}%
}

\newcommand{\cvsubsection}[1]{%
    \par\addvspace{0.75\baselineskip}%
    {\bfseries #1}\par\nobreak
    \vspace{0.05\baselineskip}%
}

% An italic run-in label opening a group of entries, e.g. a report series:
% "SEAMAN technical report series. <note>".
\newcommand{\cvrunin}[2]{%
    \par\addvspace{0.5\baselineskip}%
    \begingroup
    \interlinepenalty=10000
    \noindent\textit{#1}\ifstrempty{#2}{}{ #2}\par
    \endgroup
    \nobreak
}

% --- BODY TEXT ---------------------------------------------------------------
% A free-standing paragraph: research interests, the research program
% narrative. Left breakable, since these can legitimately run past a page.
\newcommand{\cvparagraph}[1]{%
    \par\addvspace{0.35\baselineskip}%
    \noindent #1\par
}

% A small note under a heading, e.g. the dagger key above the publications.
\newcommand{\cvnote}[1]{%
    \par\addvspace{0.3\baselineskip}%
    {\small\noindent #1\par}\nobreak
}

% A paragraph break inside an entry's details.
\newcommand{\cvpar}{\par\vspace{0.15\baselineskip}}

% An italic label run into its text inside entry details ("Maturity: ...").
\newcommand{\cvlabelled}[2]{\textit{#1:} #2}

% --- ENTRIES -----------------------------------------------------------------
% Entries set \interlinepenalty so that a page break cannot fall inside one:
% a citation is moved to the next page whole rather than cut in half.
\newcounter{cvitem}
\newlength{\cvtagwidth}   \setlength{\cvtagwidth}{3.3em}
\newlength{\cvdatemax}    \setlength{\cvdatemax}{2.1in}
\newlength{\cv@datewidth}
\newlength{\cv@headwidth}

% Number the current entry so that a \label inside it resolves to "[#1]".
% \refstepcounter supplies the hyperref anchor; the label text is then
% replaced by the tag.
\newcommand{\cv@tag}[1]{%
    \refstepcounter{cvitem}%
    \protected@edef\@currentlabel{[#1]}%
}

% Print the tag in the hanging column at the left margin.
\newcommand{\cv@tagbox}[1]{%
    \hspace*{-\cvtagwidth}\makebox[\cvtagwidth][l]{[#1]}%
}

% A dated entry: #1 tag (or empty), #2 heading, #3 date (or empty), #4 details
% (or empty). The heading sits on the left with the date flush right beside it;
% the details follow below, aligned with the heading. The date column is as
% wide as the date, up to \cvdatemax, after which the date wraps.
\newcommand{\cventry}[4]{%
    \par\addvspace{0.5\baselineskip}%
    \begingroup
    \interlinepenalty=10000
    \ifstrempty{#1}{}{\cv@tag{#1}\setlength{\leftskip}{\cvtagwidth}}%
    \ifstrempty{#3}{%
        \setlength{\cv@headwidth}{\dimexpr\linewidth-\leftskip\relax}%
    }{%
        \settowidth{\cv@datewidth}{#3}%
        \ifdim\cv@datewidth>\cvdatemax \setlength{\cv@datewidth}{\cvdatemax}\fi
        \setlength{\cv@headwidth}{\dimexpr\linewidth-\leftskip-\cv@datewidth-1.5em\relax}%
    }%
    \noindent
    \ifstrempty{#1}{}{\cv@tagbox{#1}}%
    % \leavevmode starts the line before any \label in #2, which would otherwise
    % sit above it in the box and push the heading down off the tag's baseline.
    \parbox[t]{\cv@headwidth}{\raggedright\leavevmode #2}%
    \ifstrempty{#3}{}{\hfill\parbox[t]{\cv@datewidth}{\raggedleft #3}}%
    \par
    \ifstrempty{#4}{}{\nobreak\vspace{1pt}\noindent #4\par}%
    \endgroup
}

% A numbered citation, printed as "[J3]  <citation>" with a hanging indent.
\newcommand{\cvcite}[2]{%
    \par\addvspace{0.4\baselineskip}%
    \begingroup
    \interlinepenalty=10000
    \cv@tag{#1}%
    \setlength{\leftskip}{\cvtagwidth}%
    \noindent\cv@tagbox{#1}#2\par
    \endgroup
}

% An unnumbered list item with a small hanging indent (service, reviewing).
\newcommand{\cvplain}[1]{%
    \par\addvspace{0.3\baselineskip}%
    \begingroup
    \interlinepenalty=10000
    \setlength{\hangindent}{1em}%
    \noindent #1\par
    \endgroup
}

\endinput
